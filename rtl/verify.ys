# ======================================================================
# Formal equivalence proof for the complete Holotrade admission primitive.
#
#   npm run verify:rtl
#
# Two independently written implementations are proved equal over the
# ENTIRE 25-bit input space by SAT -- not sampled, not simulated. That is
# 2^25 = 33,554,432 combinations of addresses, magic budget, and policy
# predicates. The miter covers form, adjacency, address rejection, refusal
# priority, admission, and ray cost. Cryptographic predicate generation is
# explicitly outside this circuit; the RTL consumes those predicates.
#
# This discharges address validity, direct adjacency, migration-cost and
# refusal-policy equivalence. It is not a proof of a complete router.
# ======================================================================

read_verilog rtl/holotrade_admit.v

# --- gold: independent behavioural full-gate reference
hierarchy -top holotrade_admit_golden
proc; opt; flatten; opt -full
rename holotrade_admit_golden gold
design -stash gold

# --- gate: staged F_3 implementation plus admission policy
read_verilog rtl/holotrade_admit.v
hierarchy -top holotrade_admit
proc; opt; flatten; opt -full
rename holotrade_admit gate
design -stash gate

# --- miter and prove
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
miter -equiv -flatten -make_assert gold gate miter
hierarchy -top miter
proc; opt -full

# -verify makes an unproved property a hard failure.
sat -verify -prove-asserts -show-ports miter

stat
